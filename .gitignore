# Secrets: never commit the real .env (copy .env.example to .env and fill it in instead)
.env
.env.*
!.env.example

# Python environments and caches (recreate with: python3 -m venv .venv && pip install -r requirements.txt)
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Frontend dependencies and build output (recreate with: npm --prefix frontend install)
frontend/node_modules/
# frontend/dist/ is committed on purpose: the API serves it, so running the app needs only Python

# Local tool settings and OS files
.claude/
.DS_Store

# Temporary files written while saving logs
*.tmp
