# Copy this file to .env in the project folder and fill in your own values.
# .env is listed in .gitignore, so it is never committed. Never put a real key in this example file.

# Required for anything that calls the model: your Portkey API key.
# The offline parts (calculations, scoring, tests) work without it.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: the Portkey gateway URL. This default works as it is.
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional: the model for all four agents. The course key covers gpt-6-luna only, which is the default.
# BIOVALUE_MODEL=gpt-6-luna
